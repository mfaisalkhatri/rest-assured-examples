<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "http://testng.org/testng-1.0.dtd">
<suite name="ReqRes Test Suite" thread-count="10" parallel="tests">
    <listeners>
        <listener
                class-name="restful.ecommerce.utility.TestListener"/>
    </listeners>
    <test name="Authentication Tests">
        <classes>
            <class name="restful.ecommerce.TestAuthentication">
                <methods>
                    <include name="testAuthenticationToken"/>
                    <include name="testAuthToken"/>
                </methods>
            </class>
        </classes>
    </test>
    <test name="Get Request Tests">
        <classes>
            <class name="restful.ecommerce.TestGetRequests">
                <methods>
                    <include name="getRequestTest"/>
                    <include name="getRequestTestWithQueryParam"/>
                </methods>
            </class>
        </classes>
    </test>
    <test name="Get Tests with Rest Assured Config">
        <classes>
            <class name="restful.ecommerce.TestGetRequestWithRestAssuredSpecs">
                <methods>
                    <include name="getRequestTestWithRestAssuredConfig"/>
                </methods>
            </class>
        </classes>
    </test>
    <test name="Post Request tests">
        <classes>
            <class name="restful.ecommerce.TestPostRequests">
                <methods>
                    <include name="testPostRequests"/>
                </methods>
            </class>
            <class name="restful.ecommerce.PostRequestBuilderExample">
                <methods>
                    <include name="postTestUsingBuilderPattern"/>
                </methods>
            </class>
        </classes>
    </test>
    <test name="Put Request Tests">
        <classes>
            <class name="restful.ecommerce.TestPutRequests">
                <methods>
                    <include name="putRequestsTests"/>
                </methods>
            </class>
        </classes>
    </test>
    <test name="Patch Request tests">
        <classes>
            <class name="restful.ecommerce.TestPatchRequests">
                <methods>
                    <include name="patchRequestTests"/>
                </methods>
            </class>
        </classes>
    </test>
    <test name="Delete Requests tests">
        <classes>
            <class name="restful.ecommerce.TestDeleteRequests">
                <methods>
                    <include name="deleteRequestTests"/>
                </methods>
            </class>
        </classes>
    </test>
    <test name="Test Response Headers">
        <classes>
            <class name="restful.ecommerce.TestResponseHeaders"/>
        </classes>
    </test>
    <test name="JsonPath usage tests">
        <classes>
            <class name="restful.ecommerce.TestResponseBodyWithJsonPath"/>
        </classes>
    </test>
    <test name="Awaitility Example tests" enabled="false">
        <classes>
            <class name="restful.ecommerce.TestDelayedAPIWithAwaitility"/>
        </classes>
    </test>
    <test name="Post Request Example with Java records">
        <classes>
            <class name="restful.ecommerce.TestPostWithRecords"/>
        </classes>
    </test>
</suite>