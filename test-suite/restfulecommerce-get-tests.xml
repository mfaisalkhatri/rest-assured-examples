<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "http://testng.org/testng-1.0.dtd">
<suite name="ReqRes Test Suite" thread-count="10" parallel="tests">
    <listeners>
        <listener
                class-name="restful.ecommerce.utility.TestListener"/>
    </listeners>
    <test name="Get Request Tests">
        <classes>
            <class name="restful.ecommerce.TestGetRequests">
                <methods>
                    <include name="getRequestTest"/>
                    <include name="getRequestTestWithQueryParam"/>
                </methods>
            </class>
        </classes>
    </test>
    <test name="Get Tests with Rest Assured Config">
        <classes>
            <class name="restful.ecommerce.TestGetRequestWithRestAssuredSpecs">
                <methods>
                    <include name="getRequestTestWithRestAssuredConfig"/>
                </methods>
            </class>
        </classes>
    </test>
    <test name="Test Response Headers">
        <classes>
            <class name="restful.ecommerce.TestResponseHeaders"/>
        </classes>
    </test>
    <test name="JsonPath usage tests">
        <classes>
            <class name="restful.ecommerce.TestResponseBodyWithJsonPath"/>
        </classes>
    </test>
    <test name="Awaitility Example tests" enabled="false">
        <classes>
            <class name="restful.ecommerce.TestDelayedAPIWithAwaitility"/>
        </classes>
    </test>
    <test name="Delete Requests tests">
        <classes>
            <class name="restful.ecommerce.TestDeleteRequests">
                <methods>
                    <include name="deleteRequestTests"/>
                </methods>
            </class>
        </classes>
    </test>
</suite>